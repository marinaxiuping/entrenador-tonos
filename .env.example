# Artefacto del modelo generado por scripts/25_entrenar_cnn_final.py
TONOS_MODEL_PATH=models/cnn_toneperfect_praat.pt
# Tamaño máximo de cada audio subido a la API, en MB
TONOS_MAX_UPLOAD_MB=5
# Build del frontend que sirve la API en / (npm run build en frontend/)
TONOS_FRONTEND_DIR=frontend/dist
# Paquete de la demo "¿quién te corrige?" (scripts/35_preparar_laboratorio.py); opcional
TONOS_LAB_DIR=models/laboratorio
# Corpus Tone Perfect descargado (CC BY-NC 4.0): voz nativa en la práctica; opcional
TONOS_TONE_PERFECT_DIR=data/raw/toneperfect
